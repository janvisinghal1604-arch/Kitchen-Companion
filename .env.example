# Kitchen Companion Environment Variables
# ---------------------------------------------
# Copy this file to .env for local development.
# On Vercel, configure these under: Project Settings > Environment Variables.

# 1. Supabase Integration (Optional - app gracefully falls back to local persistent storage if omitted)
# Found in: Supabase Project Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Note: Use your public `anon` public key (Row Level Security protected). NEVER expose your `service_role` secret key!
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 2. Multimodal AI Integration (Optional)
# Used for live Gemini 1.5 Flash Vision ingredient recognition and AI recipe suggestions.
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# If omitted, Kitchen Companion runs with its built-in culinary matching engine.
VITE_GEMINI_API_KEY=
